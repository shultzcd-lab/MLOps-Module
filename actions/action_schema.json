{
  "openapi": "3.0.3",
  "info": {
    "title": "ALF Google Sheets API (Apps Script)",
    "version": "1.0.5",
    "description": "ChatGPT Actions schema aligned to the current Apps Script implementation in apps_script/Code.gs.\n\nContract notes:\n- All POST requests require an API key header (X-ALF-KEY) that must match the script's ALF_API_KEY.\n- Read operations enforce a valid read token. Code.gs accepts readToken from either query (?readToken=...) or request body field readToken.\n- Code.gs accepts wrapped payloads ({\"body\":{...}}) and unwrapped payloads ({...}). This schema allows both.\n- Apps Script typically returns HTTP 200 with a JSON body describing SUCCESS/REJECTED."
  },
  "servers": [
    {
      "url": "https://script.google.com",
      "description": "Replace with your full Apps Script web app URL, e.g. https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec"
    }
  ],
  "components": {
    "securitySchemes": {
      "XAlfApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-ALF-KEY",
        "description": "Required for all POST requests. Must match ALF_API_KEY enforced by the Apps Script."
      }
    },
    "schemas": {
      "StandardResponse": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "result": { "type": "string" },
          "operation": { "type": "string" },
          "message": { "type": "string" },
          "data": {
            "type": ["object", "array", "string", "number", "boolean", "null"]
          }
        }
      },

      "PriceQuoteLine": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "item": { "type": "string" },
          "qty": {
            "oneOf": [
              { "type": "number" },
              { "type": "string", "description": "Numeric string accepted by server (coerced via Number())." }
            ]
          },
          "unitPrice": { "type": "number" },
          "description": { "type": "string" }
        },
        "required": ["item", "qty"]
      },

      "PriceQuoteBody": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "operation": { "const": "priceQuote" },
          "readToken": { "type": "string", "description": "Optional in body; may be supplied via query param readToken." },
          "jobNumber": { "type": "string" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/PriceQuoteLine" }
          }
        },
        "required": ["operation", "lines"]
      },

      "GetJobBody": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "operation": { "const": "getJob" },
          "readToken": { "type": "string", "description": "Optional in body; may be supplied via query param readToken." },
          "jobNumber": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["operation", "jobNumber"]
      },

      "GetItemBody": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "operation": { "const": "getItem" },
          "readToken": { "type": "string", "description": "Optional in body; may be supplied via query param readToken." },
          "itemCode": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["operation", "itemCode"]
      },

      "GetItemCostBody": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "operation": { "const": "getItemCost" },
          "readToken": { "type": "string", "description": "Optional in body; may be supplied via query param readToken." },
          "itemCode": { "type": "string" }
        },
        "required": ["operation", "itemCode"]
      },

      "SetJobFieldBody": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "operation": { "const": "setJobField" },
          "jobNumber": { "type": "string" },
          "fieldName": { "type": "string" },
          "fieldValue": { "type": ["string", "number", "boolean", "null", "object", "array"] },
          "requestedBy": { "type": "string" }
        },
        "required": ["operation", "jobNumber", "fieldName", "requestedBy"]
      },

      "UpdateJobStatusBody": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "operation": { "const": "updateJobStatus" },
          "jobNumber": { "type": "string" },
          "newStatus": { "type": "string" },
          "requestedBy": { "type": "string" },
          "notes": { "type": "string" },
          "requestedRole": { "type": "string" },
          "confirmPhrase": { "type": "string" }
        },
        "required": ["operation", "jobNumber", "newStatus", "requestedBy"]
      },

      "CreateJobBody": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "operation": { "const": "createJob" },
          "jobNumber": { "type": "string" },
          "requestedBy": { "type": "string" },

          "customerFullName": { "type": "string" },
          "customerPhone": { "type": "string" },
          "customerEmail": { "type": "string" },
          "customerAddress": { "type": "string" },

          "leadSource": { "type": "string" },
          "customerType": { "type": "string" },
          "estimator": { "type": "string" },

          "notes": { "type": "string" }
        },
        "required": ["operation", "jobNumber", "requestedBy"]
      },

      "UpdateItemCostBody": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "operation": { "const": "updateItemCost" },
          "itemCode": { "type": "string" },
          "newUnitCost": { "type": "number" },
          "costEffectiveDate": { "type": "string" },
          "requestedBy": { "type": "string" }
        },
        "required": ["operation", "itemCode", "newUnitCost", "costEffectiveDate", "requestedBy"]
      },

      "UpdateItemFieldBody": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "operation": { "const": "updateItemField" },
          "itemCode": { "type": "string" },
          "fieldName": { "type": "string" },
          "fieldValue": { "type": ["string", "number", "boolean", "null", "object", "array"] },
          "requestedBy": { "type": "string" }
        },
        "required": ["operation", "itemCode", "fieldName", "requestedBy"]
      },

      "CreateItemBody": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "operation": { "const": "createItem" },
          "itemCode": { "type": "string" },
          "itemName": { "type": "string" },
          "unitCost": { "type": "number" },
          "costEffectiveDate": { "type": "string" },
          "requestedBy": { "type": "string" },

          "category": { "type": "string" },
          "unitOfMeasure": { "type": "string" },
          "sourceType": { "type": "string" },
          "activeStatus": { "type": ["string", "boolean"] }
        },
        "required": [
          "operation",
          "itemCode",
          "itemName",
          "unitCost",
          "costEffectiveDate",
          "requestedBy",
          "category",
          "unitOfMeasure",
          "sourceType",
          "activeStatus"
        ]
      },

      "OperationBody": {
        "oneOf": [
          { "$ref": "#/components/schemas/PriceQuoteBody" },
          { "$ref": "#/components/schemas/GetJobBody" },
          { "$ref": "#/components/schemas/GetItemBody" },
          { "$ref": "#/components/schemas/GetItemCostBody" },
          { "$ref": "#/components/schemas/SetJobFieldBody" },
          { "$ref": "#/components/schemas/UpdateJobStatusBody" },
          { "$ref": "#/components/schemas/CreateJobBody" },
          { "$ref": "#/components/schemas/UpdateItemCostBody" },
          { "$ref": "#/components/schemas/UpdateItemFieldBody" },
          { "$ref": "#/components/schemas/CreateItemBody" }
        ]
      },

      "RequestEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "body": { "$ref": "#/components/schemas/OperationBody" }
        },
        "required": ["body"]
      }
    }
  },
  "security": [
    { "XAlfApiKey": [] }
  ],
  "paths": {
    "/macros/s/{deploymentId}/exec": {
      "post": {
        "operationId": "alfSheetsDispatcher",
        "summary": "Dispatch ALF operations to Apps Script (read/write)",
        "parameters": [
          {
            "name": "deploymentId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "readToken",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Read token for read operations. Server accepts readToken in query or body."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "#/components/schemas/RequestEnvelope" },
                  { "$ref": "#/components/schemas/OperationBody" }
                ],
                "description": "Code.gs accepts both wrapped ({\"body\":{...}}) and unwrapped ({...}) JSON payloads."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apps Script response (typically HTTP 200 with business outcome in JSON).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardResponse" }
              }
            }
          },
          "default": {
            "description": "Unexpected response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardResponse" }
              }
            }
          }
        }
      }
    }
  }
}
